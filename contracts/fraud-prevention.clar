(define-constant err-unauthorized (err u101))
(define-constant err-program-not-found (err u102))
(define-data-var program-counter uint u0)
(define-map training-programs { program-id: uint } { provider: principal, program-name: (string-ascii 50), target-audience: (string-ascii 30), launch-date: uint })
(define-map detection-techniques { program-id: uint, technique-id: uint } { technique-name: (string-ascii 40), complexity-level: uint, module-id: uint })
(define-map investigation-procedures { program-id: uint, proc-id: uint } { procedure-name: (string-ascii 40), step-count: uint, certification-required: bool })
(define-map legal-considerations { program-id: uint, legal-id: uint } { jurisdiction: (string-ascii 25), regulation-code: (string-ascii 30), compliance-date: uint })
(define-map case-studies { program-id: uint, case-id: uint } { case-name: (string-ascii 40), fraud-type: (string-ascii 25), resolution-status: (string-ascii 15) })
(define-public (create-program (program-name (string-ascii 50)) (audience (string-ascii 30))) (let ((program-id (var-get program-counter))) (map-set training-programs { program-id: program-id } { provider: tx-sender, program-name: program-name, target-audience: audience, launch-date: burn-block-height }) (var-set program-counter (+ program-id u1)) (ok program-id)))
(define-public (add-technique (program-id uint) (technique-id uint) (technique-name (string-ascii 40)) (complexity uint) (module uint)) (let ((program (map-get? training-programs { program-id: program-id }))) (asserts! (is-some program) err-program-not-found) (asserts! (is-eq tx-sender (get provider (unwrap-panic program))) err-unauthorized) (map-set detection-techniques { program-id: program-id, technique-id: technique-id } { technique-name: technique-name, complexity-level: complexity, module-id: module }) (ok true)))
(define-public (add-procedure (program-id uint) (proc-id uint) (proc-name (string-ascii 40)) (steps uint) (certification bool)) (let ((program (map-get? training-programs { program-id: program-id }))) (asserts! (is-some program) err-program-not-found) (asserts! (is-eq tx-sender (get provider (unwrap-panic program))) err-unauthorized) (map-set investigation-procedures { program-id: program-id, proc-id: proc-id } { procedure-name: proc-name, step-count: steps, certification-required: certification }) (ok true)))
(define-public (add-legal-info (program-id uint) (legal-id uint) (jurisdiction (string-ascii 25)) (code (string-ascii 30))) (let ((program (map-get? training-programs { program-id: program-id }))) (asserts! (is-some program) err-program-not-found) (asserts! (is-eq tx-sender (get provider (unwrap-panic program))) err-unauthorized) (map-set legal-considerations { program-id: program-id, legal-id: legal-id } { jurisdiction: jurisdiction, regulation-code: code, compliance-date: burn-block-height }) (ok true)))
(define-public (add-case-study (program-id uint) (case-id uint) (case-name (string-ascii 40)) (fraud-type (string-ascii 25)) (status (string-ascii 15))) (let ((program (map-get? training-programs { program-id: program-id }))) (asserts! (is-some program) err-program-not-found) (asserts! (is-eq tx-sender (get provider (unwrap-panic program))) err-unauthorized) (map-set case-studies { program-id: program-id, case-id: case-id } { case-name: case-name, fraud-type: fraud-type, resolution-status: status }) (ok true)))
(define-read-only (get-program (program-id uint)) (map-get? training-programs { program-id: program-id }))
(define-read-only (get-technique (program-id uint) (technique-id uint)) (map-get? detection-techniques { program-id: program-id, technique-id: technique-id }))
(define-read-only (get-procedure (program-id uint) (proc-id uint)) (map-get? investigation-procedures { program-id: program-id, proc-id: proc-id }))
